{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/sobre", "destination": "/proyecto", "permanent": true },
    { "source": "/sobre/:path*", "destination": "/proyecto", "permanent": true },
    { "source": "/sobre.html", "destination": "/proyecto", "permanent": true },
    { "source": "/newsletter", "destination": "/proyecto", "permanent": true },
    { "source": "/newsletter/:path*", "destination": "/proyecto", "permanent": true },
    { "source": "/contacto", "destination": "/proyecto", "permanent": true },
    { "source": "/contacto/:path*", "destination": "/proyecto", "permanent": true },

    { "source": "/habitabilidad-digital", "destination": "/habitabilidad", "permanent": true },
    { "source": "/habitabilidad-digital/:path*", "destination": "/habitabilidad", "permanent": true },
    { "source": "/habitabilidad-digital.html", "destination": "/habitabilidad", "permanent": true },
    { "source": "/capas-habitabilidad.html", "destination": "/habitabilidad", "permanent": true },

    { "source": "/indice-habitabilidad.html", "destination": "/indice", "permanent": true },
    { "source": "/herramientas", "destination": "/indice", "permanent": true },
    { "source": "/herramientas/:path*", "destination": "/indice", "permanent": true },

    { "source": "/conceptos/enshittification/", "destination": "/conceptos/enshittification", "permanent": true },
    { "source": "/conceptos", "destination": "/mapas", "permanent": true },
    { "source": "/conceptos/:slug((?!enshittification$).*)", "destination": "/mapas", "permanent": true },
    { "source": "/glosario", "destination": "/mapas", "permanent": true },
    { "source": "/glosario/:path*", "destination": "/mapas", "permanent": true },
    { "source": "/archivo", "destination": "/mapas", "permanent": true },
    { "source": "/archivo/:path*", "destination": "/mapas", "permanent": true },

    { "source": "/:ensayo(criterio|economia-contemporanea|mapa-de-tu-mente|econom%C3%ADa-contemporanea)", "destination": "/mapas", "permanent": true },
    { "source": "/:ensayo(criterio|economia-contemporanea|mapa-de-tu-mente|econom%C3%ADa-contemporanea)/:path*", "destination": "/mapas", "permanent": true },
    { "source": "/:legacy(archivo|conceptos|contacto|criterio|economia-contemporanea|mapa-de-tu-mente|newsletter|capas-criterio|capas-economia|capas-mapa-mente).html", "destination": "/", "permanent": true },
    { "source": "/referencias", "destination": "/proyecto", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/styles/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] }
  ]
}
