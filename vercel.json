{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/sobre", "destination": "/piezas/que-es-entrelampistas/", "permanent": true },
    { "source": "/habitabilidad-digital", "destination": "/temas/habitabilidad-digital/", "permanent": true },
    { "source": "/mapa-de-tu-mente", "destination": "/temas/la-atencion-como-terreno/", "permanent": true },
    { "source": "/articulo-internet", "destination": "/temas/habitabilidad-digital/", "permanent": true },
    { "source": "/ensayo-demo", "destination": "/", "permanent": true },
    { "source": "/archivo", "destination": "/", "permanent": true },
    { "source": "/contacto", "destination": "/piezas/que-es-entrelampistas/", "permanent": true },
    { "source": "/newsletter", "destination": "/", "permanent": true },
    { "source": "/newsletter/:ruta*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/search-index.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    }
  ]
}
